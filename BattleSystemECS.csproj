<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>BattleSystemECS</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>BattleSystemECS</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Config files -->
    <Compile Include="Configs\*.cs" />

    <!-- Core files -->
    <Compile Include="Core\*.cs" />
    <Compile Include="Core\GAS\*.cs" />

    <!-- Components (only actively referenced files) -->
    <Compile Include="Components\BuffData.cs" />
    <Compile Include="Components\EnemyActionType.cs" />
    <Compile Include="Components\EnemyComponent.cs" />
    <Compile Include="Components\SkillComponent.cs" />

    <!-- Systems -->
    <Compile Include="Systems\*.cs" />

    <!-- Main program -->
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="game_config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>